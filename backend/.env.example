PORT=3001
NODE_ENV=development

DATABASE_URL=postgresql://user:password@host:5432/recoveriq

JWT_SECRET=change-me-to-a-strong-secret-at-least-32-chars-long
JWT_EXPIRES_IN=7d

AI_ML_SERVICE_URL=http://localhost:8000
AI_ML_SERVICE_KEY=your_service_key_here

REDIS_URL=redis://localhost:6379

CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=https://your-public-domain-or-tunnel.com

PLATFORM_EMAIL_PROVIDER=resend
PLATFORM_FROM_EMAIL=no-reply@recoveriq.site
PLATFORM_FROM_NAME=RecoverIQ

PLATFORM_RESEND_API_KEY=re_your_platform_resend_api_key_here

PLATFORM_SENDGRID_API_KEY=SG.your_platform_sendgrid_key_here

PLATFORM_SMTP_URL=smtps://user:password@smtp.gmail.com:465

# Razorpay Test Mode API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
