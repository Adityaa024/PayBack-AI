set -euo pipefail

log() { echo "[recoveriq-userdata] $*" | tee -a /var/log/recoveriq-init.log; }

log "═══════ RecoverIQ Dev EC2 Bootstrap ═══════"

mkdir -p /opt/recoveriq
chmod 750 /opt/recoveriq

log "▶ Writing docker-compose.yml..."
cat > /opt/recoveriq/docker-compose.yml << 'COMPOSE_EOF'
${compose_content}
COMPOSE_EOF
log "  ✓ docker-compose.yml written"

log "▶ Writing start.sh..."
cat > /opt/recoveriq/start.sh << 'START_EOF'
${start_sh_content}
START_EOF
chmod +x /opt/recoveriq/start.sh
log "  ✓ start.sh written"

log "▶ Installing Docker & dependencies..."
dnf install -y docker python3 awscli amazon-ssm-agent --allowerasing || true
systemctl enable --now amazon-ssm-agent || true
systemctl enable docker
systemctl start docker
usermod -aG docker ec2-user
log "  ✓ Docker installed"

log "▶ Installing Docker Compose plugin..."
mkdir -p /usr/local/lib/docker/cli-plugins
curl -sSL "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
log "  ✓ Docker Compose $(docker compose version --short 2>/dev/null || echo 'installed') installed"

log "▶ Creating systemd service..."
cat > /etc/systemd/system/recoveriq.service << 'SYSTEMD_EOF'
[Unit]
Description=RecoverIQ Development Services (Redis + Backend + AI-Service)
Documentation=https://github.com/${github_repo}
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/recoveriq
ExecStart=/opt/recoveriq/start.sh
ExecStop=/usr/bin/docker compose -f /opt/recoveriq/docker-compose.yml down --remove-orphans
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
SyslogIdentifier=recoveriq

[Install]
WantedBy=multi-user.target
SYSTEMD_EOF

systemctl daemon-reload
systemctl enable recoveriq.service
systemctl start recoveriq.service || /opt/recoveriq/start.sh || true
log "  ✓ systemd recoveriq.service enabled and started"

cat > /opt/recoveriq/reload.sh << 'RELOAD_EOF'
#!/usr/bin/env bash
cd /opt/recoveriq
docker compose pull
docker compose up -d --remove-orphans
docker compose ps
RELOAD_EOF
chmod +x /opt/recoveriq/reload.sh

log "═══════ Bootstrap complete ═══════"
